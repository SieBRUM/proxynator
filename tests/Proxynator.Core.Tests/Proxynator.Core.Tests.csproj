<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test naming (underscores), no ConfigureAwait in tests, public test classes; tests use TestTimeout tokens. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1001;CA1848;CA1849;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Proxynator.Core\Proxynator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\config.json" Link="samples\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
