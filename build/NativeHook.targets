<Project>
  <!--
    Copies the hook DLLs of the injection capture mode (native/windows/hook, built with build/build-native.ps1 into
    artifacts/native/win-x64 and win-x86) next to the application. Import it in executable projects; the files flow to
    projects that reference them. Without the DLLs everything still builds: the injection mode then reports them
    missing (proxynator doctor), the windivert mode is unaffected.
  -->
  <PropertyGroup>
    <NativeHookDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'artifacts', 'native'))</NativeHookDir>
    <NativeHook64>$(NativeHookDir)win-x64\proxynator-hook64.dll</NativeHook64>
    <NativeHook32>$(NativeHookDir)win-x86\proxynator-hook32.dll</NativeHook32>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeHook64)" Link="proxynator-hook64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('$(NativeHook64)')" />
    <None Include="$(NativeHook32)" Link="proxynator-hook32.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('$(NativeHook32)')" />
  </ItemGroup>

  <Target Name="ReportMissingNativeHook" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT' and (!Exists('$(NativeHook64)') or !Exists('$(NativeHook32)'))">
    <Message Importance="high" Text="$(MSBuildProjectName): the hook DLLs for the injection capture mode are not built (run build/build-native.ps1); the windivert mode works without them." />
  </Target>
</Project>
