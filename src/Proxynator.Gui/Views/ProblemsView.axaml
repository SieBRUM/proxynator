<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Proxynator.Gui.ViewModels"
             x:Class="Proxynator.Gui.Views.ProblemsView"
             x:DataType="vm:ConfigWorkspace">
  <Border Classes="card" IsVisible="{Binding !!Problems.Count}" BorderBrush="{DynamicResource ErrorBrush}">
    <StackPanel Spacing="4">
      <TextBlock Classes="h2" Text="Problems" />
      <ItemsControl ItemsSource="{Binding Problems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="error" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
