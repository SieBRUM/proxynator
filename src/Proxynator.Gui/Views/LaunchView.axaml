<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Proxynator.Gui.ViewModels"
             xmlns:conv="using:Proxynator.Gui.Converters"
             x:Class="Proxynator.Gui.Views.LaunchView"
             x:DataType="vm:LaunchViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <TextBlock Classes="h1" Text="Launch" />
      <TextBlock Classes="muted" Text="{Binding ModeAdvice}" />
      <TextBlock Classes="error" Text="{Binding NotReady}" IsVisible="{Binding NotReady, Converter={x:Static conv:Display.NotEmpty}}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="16">
        <Border Classes="card">
          <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <TextBlock Classes="h2" Grid.ColumnSpan="3" Text="Start a program" />
            <TextBlock Grid.Row="1" Classes="label" Text="Program" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Program}" PlaceholderText="a path, or a command on the PATH (curl, nxc, python, …)" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Command="{Binding BrowseProgramCommand}" />
            <TextBlock Grid.Row="2" Classes="label" Text="Arguments" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Arguments}" PlaceholderText="e.g. smb dc01.corp.local -u alice -p &quot;S3cret pass&quot;" />
            <TextBlock Grid.Row="3" Classes="label" Text="Working directory" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WorkingDirectory}" PlaceholderText="optional" />
            <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Command="{Binding BrowseWorkingDirectoryCommand}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Launch" Classes="accent" Command="{Binding LaunchCommand}" />
              <Button Content="Open hooked terminal" Command="{Binding OpenTerminalCommand}" ToolTip.Tip="{x:Static vm:LaunchViewModel.TerminalDescription}" />
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes.error="{Binding MessageIsError}"
                   IsVisible="{Binding Message, Converter={x:Static conv:Display.NotEmpty}}" />

        <Border Classes="card" IsVisible="{x:Static vm:LaunchViewModel.CanAttach}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Attach to a running process" />
            <TextBlock Classes="muted" Text="Loads the hook into the process: its new connections, and those of processes it starts, follow the rules. Open connections are not affected." />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshProcessesCommand}" Margin="8,0,0,0" />
              <TextBox Text="{Binding ProcessFilter}" PlaceholderText="Filter by name or PID" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Height="200">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessEntry">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Attach" Command="{Binding AttachCommand}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="6" IsVisible="{Binding !!Launched.Count}">
          <TextBlock Classes="h2" Text="Started from here" />
          <DataGrid ItemsSource="{Binding Launched}" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="260">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding Started}" x:DataType="vm:LaunchedItem" />
              <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" x:DataType="vm:LaunchedItem" />
              <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" x:DataType="vm:LaunchedItem" />
              <DataGridTextColumn Header="How" Binding="{Binding How}" x:DataType="vm:LaunchedItem" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" x:DataType="vm:LaunchedItem" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
