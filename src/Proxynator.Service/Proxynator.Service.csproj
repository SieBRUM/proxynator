<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>proxynatord</AssemblyName>
    <RootNamespace>Proxynator.Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proxynator.Core\Proxynator.Core.csproj" />
    <ProjectReference Include="..\Proxynator.Ipc\Proxynator.Ipc.csproj" />
    <ProjectReference Include="..\Proxynator.Platform.Linux\Proxynator.Platform.Linux.csproj" />
    <ProjectReference Include="..\Proxynator.Platform.Windows\Proxynator.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Proxynator.Service.Tests" />
    <InternalsVisibleTo Include="Proxynator.IntegrationTests" />
    <InternalsVisibleTo Include="Proxynator.Gui.Tests" />
  </ItemGroup>

  <!-- WinDivert.dll and WinDivert64.sys ship next to proxynatord (Windows builds only). -->
  <Import Project="..\..\build\WinDivert.targets" />

  <!-- Native capture parts (hook DLLs, eBPF object, preload library) when built: build/build-native.ps1 and .sh. -->
  <Import Project="..\..\build\NativeArtifacts.targets" />

</Project>
