{
  "$schema": "../schema/config.schema.json",
  "version": 1,
  "settings": {
    // Machine-wide kernel capture; only the processes the rules name are redirected.
    "capture": { "mode": "ebpf" },
    // Internal names get fake addresses (only for the programs below) and are resolved by the pivot.
    "dns": {
      "mode": "remote",
      "remoteDomains": ["corp.local", "*.corp.local"],
      // Domain controller lookups (SRV: _ldap._tcp.dc._msdcs.corp.local, _kerberos._tcp...) go to this DNS server,
      // through the pivot. Set it to a domain controller's IP.
      "remoteServer": { "address": "10.0.0.10", "via": "pivot" }
    }
  },
  "proxies": [
    { "id": "pivot", "type": "socks5", "host": "127.0.0.1", "port": 1080 },
    { "id": "burp", "type": "http", "host": "127.0.0.1", "port": 8080 }
  ],
  "rules": [
    {
      // pipx installs these as Python scripts; the process is named after the script.
      "name": "NetExec and impacket through the pivot",
      "match": { "processes": ["nxc", "netexec", "nxcdb", "*/pipx/venvs/impacket/*"], "includeChildren": true },
      "action": { "type": "proxy", "target": "pivot", "udp": "block" }
    },
    {
      "name": "roadtools via Burp",
      "match": { "processes": ["roadrecon", "roadtx"], "includeChildren": true },
      "action": { "type": "proxy", "target": "burp", "udp": "block" }
    }
  ]
}
